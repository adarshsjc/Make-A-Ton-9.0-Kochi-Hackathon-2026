# Copy to .env and replace the development values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (default). Each teammate uses their own local database credentials.
DB_ENGINE=postgresql
DB_NAME=brightloop
DB_USER=brightloop_app
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional SMTP. Without EMAIL_HOST, password reset emails print to the terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Brightloop <noreply@brightloop.local>

# Optional local demo accounts; seed_demo is for development only.
DEMO_PASSWORD=BrightloopDemo!2026
